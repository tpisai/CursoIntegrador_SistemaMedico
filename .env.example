# Copia este archivo a .env y cambia los valores. El archivo .env no se sube al repositorio.
# Genera cada clave con: openssl rand -hex 32
# Usa solo letras y números: Docker Compose interpreta el carácter $ como una variable.

# Base de datos. POSTGRES_PASSWORD solo se aplica la primera vez, al crear el volumen.
POSTGRES_DB=centro_salud
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAME

# Firma de los tokens de sesión. El backend no arranca con menos de 32 caracteres.
SALUDGRAU_TOKEN_SECRETO=CAMBIAME

# Dominio público. Debe apuntar ya a la IP del servidor para que Caddy obtenga el certificado.
DOMINIO=saludgrau.example.com

# Levanta también Caddy (HTTPS). Quita esta línea para probar sin dominio en http://127.0.0.1:3000.
COMPOSE_PROFILES=ssl

# Dirección interna del backend, vista desde el frontend. Se fija al compilar la imagen: si la
# cambias, ejecuta docker compose up -d --build. Con Docker Compose no hace falta tocarla.
BACKEND_URL=http://backend:8080

# Correo (opcional). Sin SPRING_MAIL_HOST los correos solo se registran en el log. Para activarlo
# quita el # de estas líneas; no dejes SPRING_MAIL_HOST definida y vacía.
#SPRING_MAIL_HOST=smtp.example.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=cuenta@example.com
#SPRING_MAIL_PASSWORD=CAMBIAME
#SALUDGRAU_CORREO_REMITENTE="SaludGrau <no-responder@example.com>"
