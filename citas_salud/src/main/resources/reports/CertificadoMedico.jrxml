			<text><![CDATA[CENTRO DE SALUD MIGUEL GRAU]]></text>
		</element>
		<element kind="staticText" uuid="c1d2e3f4-0001-0001-0001-000000000002" x="0" y="35" width="535" height="18" fontName="Arial" fontSize="10.0" hTextAlign="Center">
			<text><![CDATA[Departamento de Certificaciones Médicas]]></text>
		</element>
		<element kind="line" uuid="c1d2e3f4-0001-0001-0001-000000000003" x="0" y="60" width="535" height="1"/>
		<element kind="staticText" uuid="c1d2e3f4-0001-0001-0001-000000000004" x="0" y="80" width="535" height="25" fontName="Arial" fontSize="14.0" bold="true" underline="true" hTextAlign="Center">
			<text><![CDATA[CERTIFICADO MÉDICO]]></text>
		</element>
		<element kind="textField" uuid="d1e2f3a4-0001-0001-0001-000000000005" x="20" y="125" width="495" height="85" fontName="Arial" fontSize="11.0" hTextAlign="Justified">
			<expression><![CDATA["El médico cirujano que suscribe certifica haber examinado el día de hoy a el/la paciente " + $P{P_NOMBRE_PACIENTE} + ", de " + ($P{P_EDAD} != null ? $P{P_EDAD} + " años de edad" : "edad no registrada") + ", identificado(a) con DNI N° " + ($P{P_DNI_PACIENTE} != null ? $P{P_DNI_PACIENTE} : "---") + " y con Historia Clínica N° " + $P{P_HISTORIA_CLINICA} + "."]]></expression>
		</element>
		<element kind="staticText" uuid="d1e2f3a4-0001-0001-0001-000000000006" x="20" y="220" width="130" height="20" fontName="Arial" fontSize="11.0" bold="true">
			<text><![CDATA[Diagnóstico:]]></text>
		</element>
		<element kind="textField" uuid="d1e2f3a4-0001-0001-0001-000000000007" x="150" y="220" width="365" height="40" fontName="Arial" fontSize="11.0">
			<expression><![CDATA[$P{P_DIAGNOSTICO} != null ? $P{P_DIAGNOSTICO} : "Evaluación médica completada sin diagnóstico reservado."]]></expression>
		</element>
		<element kind="staticText" uuid="d1e2f3a4-0001-0001-0001-000000000008" x="20" y="270" width="130" height="20" fontName="Arial" fontSize="11.0" bold="true">
			<text><![CDATA[Descanso Médico:]]></text>
		</element>
		<element kind="textField" uuid="d1e2f3a4-0001-0001-0001-000000000009" x="150" y="270" width="365" height="30" fontName="Arial" fontSize="11.0">
			<expression><![CDATA["Requiere reposo físico por el período de " + ($P{P_DIAS_DESCANSO} != null ? $P{P_DIAS_DESCANSO} : 2) + " día(s) para su recuperación."]]></expression>
		</element>
		<element kind="staticText" uuid="d1e2f3a4-0001-0001-0001-000000000010" x="20" y="310" width="130" height="20" fontName="Arial" fontSize="11.0" bold="true">
			<text><![CDATA[Indicaciones:]]></text>
		</element>
		<element kind="textField" uuid="d1e2f3a4-0001-0001-0001-000000000011" x="150" y="310" width="365" height="40" fontName="Arial" fontSize="11.0">
			<expression><![CDATA[$P{P_INDICACIONES} != null ? $P{P_INDICACIONES} : "Cumplir reposo en domicilio y seguir tratamiento prescrito."]]></expression>
		</element>
		<element kind="line" uuid="d1e2f3a4-0001-0001-0001-000000000012" x="170" y="405" width="200" height="1"/>
		<element kind="textField" uuid="d1e2f3a4-0001-0001-0001-000000000013" x="120" y="412" width="300" height="18" fontName="Arial" fontSize="10.0" bold="true" hTextAlign="Center">
			<expression><![CDATA["Dr(a). " + $P{P_NOMBRE_MEDICO}]]></expression>
		</element>
		<element kind="textField" uuid="d1e2f3a4-0001-0001-0001-000000000014" x="120" y="430" width="300" height="18" fontName="Arial" fontSize="9.0" hTextAlign="Center">
			<expression><![CDATA["C.M.P.: " + ($P{P_NUMERO_COLEGIATURA} != null ? $P{P_NUMERO_COLEGIATURA} : "") + " | " + $P{P_ESPECIALIDAD}]]></expression>
		</element>
