<?xml version="1.0" encoding="UTF-8"?>
<!-- Informe de derivación hospitalaria del Centro de Salud Miguel Grau. -->
<jasperReport name="InformeMedicoDerivacion" language="java" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24"
              whenNoDataType="AllSectionsNoDetail">
    <parameter name="ID_ATENCION" class="java.lang.Integer"/>
    <query language="sql"><![CDATA[SELECT a.id_atencion,
       CONCAT(pu.nombres, ' ', pu.apellidos) AS paciente,
       pu.dni,
       pu.telefono,
       pa.direccion,
       CONCAT(du.nombres, ' ', du.apellidos) AS doctor,
       d.cmp,
       e.nombre AS especialidad,
       c.numero_ticket,
       a.fecha_atencion,
       sd.estado AS estado_derivacion,
       sd.fecha_solicitud,
       sd.motivo AS motivo_derivacion,
       CASE WHEN sd.datos_adicionales LIKE '{%' THEN sd.datos_adicionales::jsonb ->> 'antecedentes' END AS antecedentes,
       CASE WHEN sd.datos_adicionales LIKE '{%' THEN sd.datos_adicionales::jsonb ->> 'factoresRiesgo' END AS factores_riesgo,
       CASE WHEN sd.datos_adicionales LIKE '{%' THEN sd.datos_adicionales::jsonb ->> 'establecimiento' END AS establecimiento,
       CASE WHEN sd.datos_adicionales LIKE '{%' THEN sd.datos_adicionales::jsonb ->> 'especialidad' END AS especialidad_requerida,
       sd.respuesta_admin
FROM atencion a
JOIN historia_clinica hc ON hc.id_historia = a.id_historia
JOIN paciente pa ON pa.id_paciente = hc.id_paciente
JOIN usuario pu ON pu.id_usuario = pa.id_usuario
JOIN doctor d ON d.id_doctor = a.id_doctor
JOIN usuario du ON du.id_usuario = d.id_usuario
JOIN especialidad e ON e.id_especialidad = d.id_especialidad
JOIN cita c ON c.id_cita = a.id_cita
LEFT JOIN LATERAL (
    SELECT s.estado, s.fecha_solicitud, s.motivo, s.datos_adicionales, s.respuesta_admin
    FROM solicitud s
    WHERE s.id_cita = a.id_cita AND s.tipo = 'DERIVACION'
    ORDER BY s.fecha_solicitud DESC
    LIMIT 1
) sd ON TRUE
WHERE a.id_atencion = $P{ID_ATENCION}]]></query>
    <field name="id_atencion" class="java.lang.Integer"/>
    <field name="paciente" class="java.lang.String"/>
    <field name="dni" class="java.lang.String"/>
    <field name="telefono" class="java.lang.String"/>
    <field name="direccion" class="java.lang.String"/>
    <field name="doctor" class="java.lang.String"/>
    <field name="cmp" class="java.lang.String"/>
    <field name="especialidad" class="java.lang.String"/>
    <field name="numero_ticket" class="java.lang.String"/>
    <field name="fecha_atencion" class="java.sql.Timestamp"/>
    <field name="estado_derivacion" class="java.lang.String"/>
    <field name="fecha_solicitud" class="java.sql.Timestamp"/>
    <field name="motivo_derivacion" class="java.lang.String"/>
    <field name="antecedentes" class="java.lang.String"/>
    <field name="factores_riesgo" class="java.lang.String"/>
    <field name="establecimiento" class="java.lang.String"/>
    <field name="especialidad_requerida" class="java.lang.String"/>
    <field name="respuesta_admin" class="java.lang.String"/>
    <title height="72">
        <element kind="staticText" x="0" y="0" width="535" height="18" fontSize="10.0" bold="true" hTextAlign="Center">
            <text><![CDATA[CENTRO DE SALUD MIGUEL GRAU]]></text>
        </element>
        <element kind="staticText" x="0" y="24" width="535" height="30" fontSize="18.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[INFORME DE DERIVACIÓN]]></text>
        </element>
        <element kind="line" x="0" y="63" width="535" height="1" forecolor="#1F4E79"/>
    </title>
    <detail>
        <band height="675" splitType="Stretch">
            <element kind="staticText" mode="Opaque" x="0" y="0" width="535" height="22" forecolor="#FFFFFF" backcolor="#1F4E79" fontSize="10.0" bold="true" vTextAlign="Middle">
                <paragraph leftIndent="7"/>
                <text><![CDATA[I. ANTECEDENTES GENERALES]]></text>
            </element>
            <element kind="textField" x="8" y="28" width="320" height="18" fontSize="9.0" blankWhenNull="true">
                <expression><![CDATA["NOMBRE PROFESIONAL: " + $F{doctor}]]></expression>
            </element>
            <element kind="textField" x="335" y="28" width="192" height="18" fontSize="9.0" blankWhenNull="true">
                <expression><![CDATA["CMP: " + $F{cmp}]]></expression>
            </element>
            <element kind="textField" x="8" y="49" width="519" height="18" fontSize="9.0" blankWhenNull="true">
                <expression><![CDATA["ESPECIALIDAD: " + $F{especialidad}]]></expression>
            </element>

            <element kind="staticText" mode="Opaque" x="0" y="77" width="535" height="22" forecolor="#FFFFFF" backcolor="#1F4E79" fontSize="10.0" bold="true" vTextAlign="Middle">
                <paragraph leftIndent="7"/>
                <text><![CDATA[II. ANTECEDENTES PERSONALES DEL USUARIO]]></text>
            </element>
            <element kind="textField" x="8" y="105" width="519" height="18" fontSize="9.0" blankWhenNull="true">
                <expression><![CDATA["NOMBRE Y APELLIDOS: " + $F{paciente}]]></expression>
            </element>
            <element kind="textField" x="8" y="126" width="250" height="18" fontSize="9.0" blankWhenNull="true">
                <expression><![CDATA["DNI: " + $F{dni}]]></expression>
            </element>
            <element kind="textField" x="270" y="126" width="257" height="18" fontSize="9.0" blankWhenNull="true">
                <expression><![CDATA["TELÉFONO: " + ($F{telefono} == null ? "No registrado" : $F{telefono})]]></expression>
            </element>
            <element kind="textField" x="8" y="147" width="519" height="18" fontSize="9.0" textAdjust="StretchHeight" blankWhenNull="true">
                <expression><![CDATA["DOMICILIO: " + ($F{direccion} == null ? "No registrado" : $F{direccion})]]></expression>
            </element>

            <element kind="staticText" mode="Opaque" x="0" y="178" width="535" height="22" forecolor="#FFFFFF" backcolor="#1F4E79" fontSize="10.0" bold="true" vTextAlign="Middle">
                <paragraph leftIndent="7"/>
                <text><![CDATA[IV. ANTECEDENTES RELATIVOS A CONDICIÓN Y SITUACIÓN ACTUAL]]></text>
            </element>
            <element kind="staticText" x="8" y="207" width="519" height="16" fontSize="9.0" bold="true">
                <text><![CDATA[ANTECEDENTES]]></text>
            </element>
            <element kind="rectangle" x="8" y="226" width="519" height="88" forecolor="#9AA7B2" backcolor="#FFFFFF"/>
            <element kind="textField" x="14" y="231" width="507" height="78" fontSize="9.0" textAdjust="StretchHeight" blankWhenNull="true">
                <expression><![CDATA[$F{antecedentes} == null || $F{antecedentes}.trim().isEmpty() ? "Sin registro" : $F{antecedentes}]]></expression>
            </element>
            <element kind="staticText" x="8" y="321" width="519" height="16" fontSize="9.0" bold="true">
                <text><![CDATA[MOTIVO DE DERIVACIÓN]]></text>
            </element>
            <element kind="rectangle" x="8" y="340" width="519" height="88" forecolor="#9AA7B2" backcolor="#FFFFFF"/>
            <element kind="textField" x="14" y="345" width="507" height="78" fontSize="9.0" textAdjust="StretchHeight" blankWhenNull="true">
                <expression><![CDATA[$F{motivo_derivacion} == null || $F{motivo_derivacion}.trim().isEmpty() ? "Sin registro" : $F{motivo_derivacion}]]></expression>
            </element>

            <element kind="staticText" mode="Opaque" x="0" y="442" width="535" height="22" forecolor="#FFFFFF" backcolor="#1F4E79" fontSize="10.0" bold="true" vTextAlign="Middle">
                <paragraph leftIndent="7"/>
                <text><![CDATA[FACTORES DE RIESGO]]></text>
            </element>
            <element kind="rectangle" x="8" y="472" width="519" height="78" forecolor="#9AA7B2" backcolor="#FFFFFF"/>
            <element kind="textField" x="14" y="477" width="507" height="68" fontSize="9.0" textAdjust="StretchHeight" blankWhenNull="true">
                <expression><![CDATA[$F{factores_riesgo} == null || $F{factores_riesgo}.trim().isEmpty() ? "Sin registro" : $F{factores_riesgo}]]></expression>
            </element>
            <element kind="textField" x="8" y="562" width="519" height="18" fontSize="9.0" bold="true" blankWhenNull="true">
                <expression><![CDATA["DESTINO: " + ($F{establecimiento} == null ? "No registrado" : $F{establecimiento}) + " — ESPECIALIDAD: " + ($F{especialidad_requerida} == null ? "No registrada" : $F{especialidad_requerida})]]></expression>
            </element>
            <element kind="textField" x="8" y="584" width="519" height="18" fontSize="8.0" blankWhenNull="true">
                <expression><![CDATA["Solicitud: " + ($F{estado_derivacion} == null ? "No registrada" : $F{estado_derivacion}) + ($F{fecha_solicitud} == null ? "" : " · " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fecha_solicitud}))]]></expression>
            </element>
            <element kind="textField" x="8" y="606" width="519" height="36" fontSize="8.0" textAdjust="StretchHeight" blankWhenNull="true">
                <expression><![CDATA["Respuesta de administración: " + ($F{respuesta_admin} == null || $F{respuesta_admin}.trim().isEmpty() ? "Pendiente" : $F{respuesta_admin})]]></expression>
            </element>
            <element kind="line" x="300" y="655" width="227" height="1" forecolor="#555555"/>
            <element kind="textField" x="300" y="657" width="227" height="14" fontSize="8.0" hTextAlign="Center" blankWhenNull="true">
                <expression><![CDATA[$F{doctor} + " — CMP " + $F{cmp}]]></expression>
            </element>
        </band>
    </detail>
    <pageFooter height="18">
        <element kind="textField" x="335" y="2" width="200" height="14" fontSize="8.0" hTextAlign="Right">
            <expression><![CDATA["Atención N.º " + $F{id_atencion} + " · Página " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>
