    <parameter name="P_HISTORIA_CLINICA" class="java.lang.String"/>
    <field name="titulo" class="java.lang.String"/>
    <field name="contenido" class="java.lang.String"/>
    <title height="148" splitType="Stretch">
        <element kind="staticText" x="0" y="0" width="564" height="25" style="Title" hTextAlign="Center">
            <text><![CDATA[CENTRO DE SALUD MIGUEL GRAU]]></text>
