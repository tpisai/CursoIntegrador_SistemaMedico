<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="OrdenExamenes" language="java" pageWidth="612" pageHeight="792"
              columnWidth="564" leftMargin="24" rightMargin="24" topMargin="28" bottomMargin="28">

    <!-- ESTILOS -->
    <style name="MainTitle" fontName="Arial" fontSize="16.0" bold="true" forecolor="#1B4F72"/>
    <style name="SubTitle" fontName="Arial" fontSize="12.0" bold="true" forecolor="#2874A6"/>
    <style name="BoxHeader" mode="Opaque" backcolor="#1B4F72" forecolor="#FFFFFF" fontName="Arial" fontSize="10.0" bold="true" vTextAlign="Middle">
        <box leftPadding="8" rightPadding="8">
            <pen lineWidth="0.75" lineColor="#1B4F72"/>
        </box>
    </style>
    <style name="Label" fontName="Arial" fontSize="9.5" bold="true" forecolor="#1B4F72" vTextAlign="Middle"/>
    <style name="Body" fontName="Arial" fontSize="9.5" forecolor="#2C3E50" vTextAlign="Middle"/>
    <style name="BoxContainer" mode="Opaque" backcolor="#FFFFFF">
        <box>
            <pen lineWidth="0.75" lineColor="#85C1E9"/>
        </box>
    </style>
    <style name="FooterText" fontName="Arial" fontSize="8.5" italic="true" forecolor="#5D6D7E" vTextAlign="Middle"/>

    <!-- PARÁMETROS -->
    <parameter name="P_NUMERO_ORDEN" class="java.lang.String"/>
    <parameter name="P_FECHA_EMISION" class="java.lang.String"/>
    <parameter name="P_NOMBRE_PACIENTE" class="java.lang.String"/>
    <parameter name="P_DNI_PACIENTE" class="java.lang.String"/>
    <parameter name="P_HISTORIA_CLINICA" class="java.lang.String"/>

    <!-- CAMPOS -->
    <field name="titulo" class="java.lang.String"/>
    <field name="contenido" class="java.lang.String"/>

    <!-- CABECERA DEL REPORTE -->
    <title height="185" splitType="Stretch">
        
        <!-- Encabezado Institucional -->
        <element kind="staticText" x="0" y="0" width="564" height="22" style="MainTitle" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[CENTRO DE SALUD MIGUEL GRAU]]></text>
        </element>
        <element kind="staticText" x="0" y="22" width="564" height="18" style="SubTitle" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[ORDEN DE EXÁMENES]]></text>
        </element>
        <element kind="line" x="0" y="45" width="564" height="1">
            <pen lineWidth="1.5" lineColor="#1B4F72"/>
        </element>

        <!-- CUADRO 1: DATOS DE LA ORDEN -->
        <element kind="frame" x="0" y="55" width="564" height="44" style="BoxContainer">
            <element kind="staticText" x="0" y="0" width="564" height="20" style="BoxHeader">
                <text><![CDATA[INFORMACIÓN DE LA ORDEN]]></text>
            </element>
            <element kind="staticText" x="8" y="22" width="102" height="20" style="Label">
                <text><![CDATA[Número de orden:]]></text>
            </element>
            <element kind="textField" x="110" y="22" width="180" height="20" style="Body" blankWhenNull="true">
                <expression><![CDATA[$P{P_NUMERO_ORDEN}]]></expression>
            </element>
            <element kind="staticText" x="355" y="22" width="95" height="20" style="Label">
                <text><![CDATA[Fecha de emisión:]]></text>
            </element>
            <element kind="textField" x="450" y="22" width="106" height="20" style="Body" blankWhenNull="true">
                <expression><![CDATA[$P{P_FECHA_EMISION}]]></expression>
            </element>
        </element>

        <!-- CUADRO 2: DATOS DEL PACIENTE -->
        <element kind="frame" x="0" y="108" width="564" height="68" style="BoxContainer">
            <element kind="staticText" x="0" y="0" width="564" height="20" style="BoxHeader">
                <text><![CDATA[DATOS DEL PACIENTE]]></text>
            </element>
            
            <!-- Fila 1: Nombre y DNI -->
            <element kind="staticText" x="8" y="23" width="55" height="20" style="Label">
                <text><![CDATA[Nombre:]]></text>
            </element>
            <element kind="textField" x="63" y="23" width="335" height="20" style="Body" blankWhenNull="true">
                <expression><![CDATA[$P{P_NOMBRE_PACIENTE}]]></expression>
            </element>
            <element kind="staticText" x="410" y="23" width="32" height="20" style="Label">
                <text><![CDATA[DNI:]]></text>
            </element>
            <element kind="textField" x="442" y="23" width="114" height="20" style="Body" blankWhenNull="true">
                <expression><![CDATA[$P{P_DNI_PACIENTE}]]></expression>
            </element>

            <!-- Línea divisoria interna sutil -->
            <element kind="line" x="8" y="44" width="548" height="1">
                <pen lineWidth="0.5" lineColor="#D6EAF8"/>
            </element>

            <!-- Fila 2: Historia Clínica -->
            <element kind="staticText" x="8" y="46" width="90" height="20" style="Label">
                <text><![CDATA[Historia clínica:]]></text>
            </element>
            <element kind="textField" x="98" y="46" width="458" height="20" style="Body" blankWhenNull="true">
                <expression><![CDATA[$P{P_HISTORIA_CLINICA}]]></expression>
            </element>
        </element>

    </title>

    <!-- CUADROS DINÁMICOS DE EXÁMENES -->
    <detail>
        <band height="58" splitType="Prevent">
            <element kind="frame" x="0" y="0" width="564" height="50" style="BoxContainer">
                <!-- Encabezado azul con el título del examen -->
                <element kind="textField" x="0" y="0" width="564" height="20" style="BoxHeader" blankWhenNull="true">
                    <expression><![CDATA[$F{titulo}]]></expression>
                </element>
                <!-- Contenido del examen (se expande verticalmente según el texto) -->
                <element kind="textField" x="0" y="20" width="564" height="30" style="Body" textAdjust="StretchHeight" blankWhenNull="true">
                    <box topPadding="6" bottomPadding="6" leftPadding="8" rightPadding="8"/>
                    <expression><![CDATA[$F{contenido}]]></expression>
                </element>
            </element>
        </band>
    </detail>

    <!-- PIE DE PÁGINA -->
    <pageFooter height="30">
        <element kind="line" x="0" y="4" width="564" height="1">
            <pen lineWidth="0.75" lineColor="#85C1E9"/>
        </element>
        <element kind="staticText" x="0" y="8" width="564" height="18" style="FooterText" hTextAlign="Center">
            <text><![CDATA[Documento confidencial - uso exclusivo del paciente y personal autorizado]]></text>
        </element>
    </pageFooter>

</jasperReport>