<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ficha_consulta_paciente" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail">
	<parameter name="ID_PACIENTE" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT a.id_atencion, pa.id_paciente, CONCAT(pu.nombres, ' ', pu.apellidos) AS paciente, pu.dni, pa.fecha_nacimiento, pa.sexo, pa.grupo_sanguineo, hc.numero_historia, CONCAT(du.nombres, ' ', du.apellidos) AS doctor, d.cmp, e.nombre AS especialidad, c.numero_ticket, a.fecha_atencion, a.estado, x.seccion, x.orden, x.sub, x.titulo, x.detalle
FROM atencion a
JOIN historia_clinica hc ON hc.id_historia = a.id_historia
JOIN paciente pa ON pa.id_paciente = hc.id_paciente
JOIN usuario pu ON pu.id_usuario = pa.id_usuario
JOIN doctor d ON d.id_doctor = a.id_doctor
JOIN usuario du ON du.id_usuario = d.id_usuario
JOIN especialidad e ON e.id_especialidad = d.id_especialidad
JOIN cita c ON c.id_cita = a.id_cita
JOIN (
  SELECT a.id_atencion, 'Síntomas' AS seccion, 1 AS orden, 0::bigint AS sub, NULL::text AS titulo, COALESCE(NULLIF(TRIM(a.anamnesis), ''), 'Sin registro') AS detalle FROM atencion a
  UNION ALL
  SELECT a.id_atencion, 'Exploración física' AS seccion, 2 AS orden, 0::bigint AS sub, NULL::text AS titulo, COALESCE(NULLIF(TRIM(a.examen_fisico), ''), 'Sin registro') AS detalle FROM atencion a
  UNION ALL
  SELECT a.id_atencion, 'Diagnóstico' AS seccion, 3 AS orden, 0::bigint AS sub, NULL::text AS titulo, COALESCE(NULLIF(TRIM(a.diagnostico), ''), 'Sin registro') AS detalle FROM atencion a
  UNION ALL
  SELECT a.id_atencion, 'Tratamiento' AS seccion, 4 AS orden, 0::bigint AS sub, NULL::text AS titulo, COALESCE(NULLIF(TRIM(a.tratamiento), ''), 'Sin registro') AS detalle FROM atencion a
  UNION ALL
  SELECT a.id_atencion, 'Observaciones' AS seccion, 5 AS orden, 0::bigint AS sub, NULL::text AS titulo, COALESCE(NULLIF(TRIM(a.observaciones), ''), 'Sin registro') AS detalle FROM atencion a
) x ON x.id_atencion = a.id_atencion
WHERE pa.id_paciente = $P{ID_PACIENTE}
ORDER BY a.fecha_atencion DESC, a.id_atencion, x.orden, x.sub]]>
	</queryString>
	<field name="id_atencion" class="java.lang.Integer"/>
	<field name="id_paciente" class="java.lang.Integer"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="dni" class="java.lang.String"/>
	<field name="fecha_nacimiento" class="java.sql.Date"/>
	<field name="sexo" class="java.lang.String"/>
	<field name="grupo_sanguineo" class="java.lang.String"/>
	<field name="numero_historia" class="java.lang.String"/>
	<field name="doctor" class="java.lang.String"/>
	<field name="cmp" class="java.lang.String"/>
	<field name="especialidad" class="java.lang.String"/>
	<field name="numero_ticket" class="java.lang.String"/>
	<field name="fecha_atencion" class="java.sql.Timestamp"/>
	<field name="estado" class="java.lang.String"/>
	<field name="seccion" class="java.lang.String"/>
	<field name="orden" class="java.lang.Integer"/>
	<field name="sub" class="java.lang.Long"/>
	<field name="titulo" class="java.lang.String"/>
	<field name="detalle" class="java.lang.String"/>
	<group name="grpPaciente">
		<groupExpression><![CDATA[$F{id_paciente}]]></groupExpression>
		<groupHeader>
			<band height="82">
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="0" width="535" height="18"/>
					<textElement><font size="11" isBold="true"/></textElement>
					<textFieldExpression><![CDATA["Paciente: " + $F{paciente}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="20" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["DNI: " + $F{dni}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="270" y="20" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["Fecha de nacimiento: " + ($F{fecha_nacimiento} == null ? "-" : new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fecha_nacimiento}))]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="38" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["Sexo: " + ($F{sexo} == null ? "-" : $F{sexo})]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="270" y="38" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["Grupo sanguíneo: " + ($F{grupo_sanguineo} == null ? "-" : $F{grupo_sanguineo})]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="56" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["N.º historia clínica: " + $F{numero_historia}]]></textFieldExpression>
				</textField>

			</band>
		</groupHeader>
	</group>
	<group name="grpAtencion" minHeightToStartNewPage="90">
		<groupExpression><![CDATA[$F{id_atencion}]]></groupExpression>
		<groupHeader>
			<band height="70">
				<rectangle><reportElement mode="Opaque" x="0" y="4" width="535" height="20" backcolor="#1F4E79"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
				<textField>
					<reportElement x="0" y="4" width="535" height="20" forecolor="#FFFFFF"/>
					<textElement verticalAlignment="Middle"><font size="11" isBold="true"/><paragraph leftIndent="6"/></textElement>
					<textFieldExpression><![CDATA["Ficha de consulta - " + ($F{fecha_atencion} == null ? "-" : new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format($F{fecha_atencion}))]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="28" width="265" height="16"/>
					<textElement><font size="9" isBold="true"/></textElement>
					<textFieldExpression><![CDATA["Doctor(a): " + $F{doctor}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="270" y="28" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["Especialidad: " + $F{especialidad}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="46" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["N.º de ticket: " + $F{numero_ticket}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="270" y="46" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["Estado: " + $F{estado}]]></textFieldExpression>
				</textField>

			</band>
		</groupHeader>
		<groupFooter><band height="10"/></groupFooter>
	</group>
	<title>
		<band height="60">
			<staticText>
				<reportElement x="0" y="0" width="535" height="16"/>
				<textElement textAlignment="Center"><font size="9"/></textElement>
				<text><![CDATA[CENTRO DE SALUD MIGUEL GRAU]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="18" width="535" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="18" isBold="true"/></textElement>
				<text><![CDATA[Fichas de Consulta del Paciente]]></text>
			</staticText>
		</band>
	</title>
	<detail>
		<band height="20" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="2" width="110" height="16"/>
				<textElement><font size="10" isBold="true"/><paragraph leftIndent="6"/></textElement>
				<textFieldExpression><![CDATA[$F{seccion}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="112" y="2" width="423" height="16"/>
				<textElement><font size="10"/><paragraph rightIndent="4"/></textElement>
				<textFieldExpression><![CDATA[($F{titulo} == null || $F{titulo}.trim().isEmpty()) ? ($F{detalle} == null ? "" : $F{detalle}) : $F{titulo} + ($F{detalle} == null || $F{detalle}.isEmpty() ? "" : ": " + $F{detalle})]]></textFieldExpression>
			</textField>
			<line><reportElement positionType="FixRelativeToBottom" x="0" y="19" width="535" height="1" forecolor="#DDDDDD"/></line>
		</band>
	</detail>
	<pageFooter>
		<band height="22">
			<textField>
				<reportElement x="335" y="4" width="100" height="14"/>
				<textElement textAlignment="Right"><font size="8"/></textElement>
				<textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement x="438" y="4" width="40" height="14"/>
				<textElement><font size="8"/></textElement>
				<textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
