<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informe_medico" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail">
	<parameter name="ID_ATENCION" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT a.id_atencion, pa.id_paciente, CONCAT(pu.nombres, ' ', pu.apellidos) AS paciente, pu.dni, pa.fecha_nacimiento, pa.sexo, pa.grupo_sanguineo, hc.numero_historia, CONCAT(du.nombres, ' ', du.apellidos) AS doctor, d.cmp, e.nombre AS especialidad, c.numero_ticket, a.fecha_atencion, a.estado, x.seccion, x.orden, x.sub, x.titulo, x.detalle
FROM atencion a
JOIN historia_clinica hc ON hc.id_historia = a.id_historia
JOIN paciente pa ON pa.id_paciente = hc.id_paciente
JOIN usuario pu ON pu.id_usuario = pa.id_usuario
JOIN doctor d ON d.id_doctor = a.id_doctor
JOIN usuario du ON du.id_usuario = d.id_usuario
JOIN especialidad e ON e.id_especialidad = d.id_especialidad
JOIN cita c ON c.id_cita = a.id_cita
JOIN (
  SELECT a.id_atencion, 'Evaluación médica' AS seccion, 1 AS orden, 1::bigint AS sub, 'Motivo de la cita' AS titulo, COALESCE(NULLIF(TRIM(c2.motivo), ''), 'Sin registro') AS detalle FROM atencion a JOIN cita c2 ON c2.id_cita = a.id_cita
  UNION ALL
  SELECT a.id_atencion, 'Evaluación médica' AS seccion, 1 AS orden, 2::bigint AS sub, 'Signos vitales (triaje del ' || TO_CHAR(t.fecha_triaje, 'DD/MM/YYYY HH24:MI') || ')' AS titulo, CONCAT_WS(' | ', 'Peso: ' || t.peso || ' kg', 'Talla: ' || t.talla || ' cm', 'Presión arterial: ' || t.presion_arterial, 'FC: ' || t.frecuencia_cardiaca || ' lpm', 'Temperatura: ' || t.temperatura || ' °C', 'SatO2: ' || t.saturacion_oxigeno || ' %', 'Obs: ' || t.observaciones) AS detalle FROM atencion a JOIN LATERAL (SELECT * FROM triaje t2 WHERE t2.id_historia = a.id_historia AND t2.fecha_triaje <= a.fecha_atencion ORDER BY t2.fecha_triaje DESC LIMIT 1) t ON TRUE
  UNION ALL
  SELECT a.id_atencion, 'Evaluación médica' AS seccion, 1 AS orden, 3::bigint AS sub, 'Anamnesis' AS titulo, COALESCE(NULLIF(TRIM(a.anamnesis), ''), 'Sin registro') AS detalle FROM atencion a
  UNION ALL
  SELECT a.id_atencion, 'Evaluación médica' AS seccion, 1 AS orden, 4::bigint AS sub, 'Examen físico' AS titulo, COALESCE(NULLIF(TRIM(a.examen_fisico), ''), 'Sin registro') AS detalle FROM atencion a
  UNION ALL
  SELECT a.id_atencion, 'Diagnóstico' AS seccion, 2 AS orden, 0::bigint AS sub, NULL::text AS titulo, COALESCE(NULLIF(TRIM(a.diagnostico), ''), 'Sin registro') AS detalle FROM atencion a
  UNION ALL
  SELECT a.id_atencion, 'Evolución del paciente', 3, EXTRACT(EPOCH FROM p.fecha_atencion)::bigint, TO_CHAR(p.fecha_atencion, 'DD/MM/YYYY'), CONCAT_WS(' | ', 'Diagnóstico: ' || NULLIF(TRIM(p.diagnostico), ''), 'Tratamiento: ' || NULLIF(TRIM(p.tratamiento), ''), 'Obs: ' || NULLIF(TRIM(p.observaciones), '')) FROM atencion a JOIN atencion p ON p.id_historia = a.id_historia AND p.fecha_atencion < a.fecha_atencion
  UNION ALL
  SELECT a.id_atencion, 'Evolución del paciente', 3, 0, 'Sin atenciones previas', 'Esta es la primera atención registrada en la historia clínica del paciente.' FROM atencion a WHERE NOT EXISTS (SELECT 1 FROM atencion p WHERE p.id_historia = a.id_historia AND p.fecha_atencion < a.fecha_atencion)
  UNION ALL
  SELECT a.id_atencion, 'Recomendaciones' AS seccion, 4 AS orden, 1::bigint AS sub, 'Tratamiento indicado' AS titulo, COALESCE(NULLIF(TRIM(a.tratamiento), ''), 'Sin registro') AS detalle FROM atencion a
  UNION ALL
  SELECT a.id_atencion, 'Recomendaciones' AS seccion, 4 AS orden, 2::bigint AS sub, 'Indicaciones y observaciones' AS titulo, COALESCE(NULLIF(TRIM(a.observaciones), ''), 'Sin registro') AS detalle FROM atencion a
  UNION ALL
  SELECT a.id_atencion, 'Recomendaciones', 4, COALESCE(dm.orden, 1) + 10, dm.nombre_medicamento, CONCAT_WS(' | ', 'Dosis: ' || dm.dosis, 'Cantidad: ' || dm.cantidad, 'Vía: ' || dm.via_administracion, 'Presentación: ' || dm.presentacion, 'Unidades por toma: ' || dm.unidades_por_toma, 'Frecuencia: ' || dm.frecuencia, 'Duración: ' || dm.duracion) FROM atencion a JOIN detalle_medicamento dm ON dm.id_atencion = a.id_atencion
  UNION ALL
  SELECT a.id_atencion, 'Recomendaciones', 4, 10 + 1, 'Sin medicamentos registrados', 'No se recetaron medicamentos en esta atención.' FROM atencion a WHERE NOT EXISTS (SELECT 1 FROM detalle_medicamento dm WHERE dm.id_atencion = a.id_atencion)
) x ON x.id_atencion = a.id_atencion
WHERE a.id_atencion = $P{ID_ATENCION}
ORDER BY x.orden, x.sub, x.titulo]]>
	</queryString>
	<field name="id_atencion" class="java.lang.Integer"/>
	<field name="id_paciente" class="java.lang.Integer"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="dni" class="java.lang.String"/>
	<field name="fecha_nacimiento" class="java.sql.Date"/>
	<field name="sexo" class="java.lang.String"/>
	<field name="grupo_sanguineo" class="java.lang.String"/>
	<field name="numero_historia" class="java.lang.String"/>
	<field name="doctor" class="java.lang.String"/>
	<field name="cmp" class="java.lang.String"/>
	<field name="especialidad" class="java.lang.String"/>
	<field name="numero_ticket" class="java.lang.String"/>
	<field name="fecha_atencion" class="java.sql.Timestamp"/>
	<field name="estado" class="java.lang.String"/>
	<field name="seccion" class="java.lang.String"/>
	<field name="orden" class="java.lang.Integer"/>
	<field name="sub" class="java.lang.Long"/>
	<field name="titulo" class="java.lang.String"/>
	<field name="detalle" class="java.lang.String"/>
	<group name="grpAtencion">
		<groupExpression><![CDATA[$F{id_atencion}]]></groupExpression>
		<groupHeader>
			<band height="132">
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="0" width="535" height="18"/>
					<textElement><font size="11" isBold="true"/></textElement>
					<textFieldExpression><![CDATA["Paciente: " + $F{paciente}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="20" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["DNI: " + $F{dni}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="270" y="20" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["Fecha de nacimiento: " + ($F{fecha_nacimiento} == null ? "-" : new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fecha_nacimiento}))]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="38" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["Sexo: " + ($F{sexo} == null ? "-" : $F{sexo})]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="270" y="38" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["Grupo sanguíneo: " + ($F{grupo_sanguineo} == null ? "-" : $F{grupo_sanguineo})]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="56" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["N.º historia clínica: " + $F{numero_historia}]]></textFieldExpression>
				</textField>

				<line><reportElement x="0" y="76" width="535" height="1" forecolor="#999999"/></line>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="84" width="265" height="16"/>
					<textElement><font size="9" isBold="true"/></textElement>
					<textFieldExpression><![CDATA["Doctor(a): " + $F{doctor}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="270" y="84" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["CMP: " + $F{cmp}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="102" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["Especialidad: " + $F{especialidad}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="270" y="102" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["Fecha de atención: " + ($F{fecha_atencion} == null ? "-" : new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format($F{fecha_atencion}))]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="0" y="120" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["N.º de ticket: " + $F{numero_ticket}]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement x="270" y="120" width="265" height="16"/>
					<textElement><font size="9"/></textElement>
					<textFieldExpression><![CDATA["Estado: " + $F{estado}]]></textFieldExpression>
				</textField>

			</band>
		</groupHeader>
	</group>
	<group name="grpSeccion" minHeightToStartNewPage="50">
		<groupExpression><![CDATA[$F{seccion}]]></groupExpression>
		<groupHeader>
			<band height="30">
				<textField>
					<reportElement mode="Opaque" x="0" y="6" width="535" height="20" backcolor="#1F4E79" forecolor="#FFFFFF"/>
					<textElement verticalAlignment="Middle"><font size="11" isBold="true"/><paragraph leftIndent="6"/></textElement>
					<textFieldExpression><![CDATA[$F{seccion}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
		<groupFooter><band height="4"/></groupFooter>
	</group>
	<title>
		<band height="60">
			<staticText>
				<reportElement x="0" y="0" width="535" height="16"/>
				<textElement textAlignment="Center"><font size="9"/></textElement>
				<text><![CDATA[CENTRO DE SALUD MIGUEL GRAU]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="18" width="535" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="18" isBold="true"/></textElement>
				<text><![CDATA[Informe Médico]]></text>
			</staticText>
		</band>
	</title>
	<detail>
		<band height="20" splitType="Stretch">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="0" y="2" width="535" height="16"/>
				<textElement><font size="10"/><paragraph leftIndent="6" rightIndent="4"/></textElement>
				<textFieldExpression><![CDATA[($F{titulo} == null || $F{titulo}.trim().isEmpty()) ? ($F{detalle} == null ? "" : $F{detalle}) : $F{titulo} + ($F{detalle} == null || $F{detalle}.isEmpty() ? "" : ": " + $F{detalle})]]></textFieldExpression>
			</textField>
			<line><reportElement positionType="FixRelativeToBottom" x="0" y="19" width="535" height="1" forecolor="#DDDDDD"/></line>
		</band>
	</detail>
	<pageFooter>
		<band height="22">
			<textField>
				<reportElement x="335" y="4" width="100" height="14"/>
				<textElement textAlignment="Right"><font size="8"/></textElement>
				<textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement x="438" y="4" width="40" height="14"/>
				<textElement><font size="8"/></textElement>
				<textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<summary>
		<band height="90">
			<line><reportElement x="300" y="60" width="235" height="1"/></line>
			<textField isBlankWhenNull="true">
				<reportElement x="300" y="63" width="235" height="14"/>
				<textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{doctor}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="300" y="77" width="235" height="12"/>
				<textElement textAlignment="Center"><font size="8"/></textElement>
				<textFieldExpression><![CDATA["Firma y sello - CMP " + $F{cmp}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
